@model QIP.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<section class="login-card">
    <div>
        <span class="eyebrow">Ward access</span>
        <h1 class="mb-3">Enter a 4 digit code</h1>
        <p class="text-muted mb-4">Valid demo codes: 1111, 2222, 3333.</p>
    </div>

    <form asp-action="Login" method="post" class="login-form">
        @Html.AntiForgeryToken()
        <label asp-for="Code" class="form-label">Access code</label>
        <input asp-for="Code" class="form-control form-control-lg" inputmode="numeric" autocomplete="one-time-code" maxlength="4" placeholder="1111" />
        <span asp-validation-for="Code" class="text-danger small"></span>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger mt-3 mb-0">@Model.ErrorMessage</div>
        }

        <button type="submit" class="btn btn-primary btn-lg w-100 mt-4">Continue</button>
    </form>
</section>
